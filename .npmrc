# @g-loot/react-tournament-brackets@1.0.31-rc declares peer deps on React
# 18 (react, react-dom) and styled-components@^4 — all still work fine at
# runtime with our React 19 / styled-components 6 versions (verified via
# a full build + SSR smoke test), the package just hasn't published a
# peer-range bump. Without this, `npm ci` (used by CI and Heroku's
# buildpack) fails outright on the unresolved peer conflict.
legacy-peer-deps=true
