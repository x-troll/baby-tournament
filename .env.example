# Copy to .env and fill in for local development.
# On Heroku these are set as config vars instead of a committed file.

# Postgres connection string. Locally, point at a local/dev Postgres instance;
# on Heroku this is provided automatically by the Heroku Postgres add-on.
DATABASE_URL="postgresql://localhost:5432/playtime?schema=public"

# Session signing secret (baby magic-link cookies + admin sessions).
# Generate with: openssl rand -base64 32
AUTH_SECRET=""

# Seeds the first Daddy account on `release` (scripts/ensure-admin-seed.ts).
# Only used once — change the password from the admin panel afterwards.
ADMIN_USERNAME=""
ADMIN_PASSWORD=""

# Telegram Bot API (create via @BotFather).
TELEGRAM_BOT_TOKEN=""
# The bot's @username (without the @), used to build t.me/<username>?start=...
# deep links for both baby join QR codes and admin Telegram-linking.
TELEGRAM_BOT_USERNAME=""
# Arbitrary secret string, verified against the X-Telegram-Bot-Api-Secret-Token
# header on incoming webhook requests. Generate with: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=""

# Public base URL of the deployed app (used to build Telegram deep links and
# to register the webhook). No trailing slash.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# nursery (default, ABDL-coded skin) | plain (neutral skin for screenshots/testing)
THEME="nursery"
